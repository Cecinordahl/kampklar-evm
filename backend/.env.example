# Full contents of the Firebase service account JSON, as a single-line string (not a file path)
FIREBASE_SERVICE_ACCOUNT_JSON=

# UID of the single provisioned admin account (Firebase Auth > Users)
ADMIN_UID=

# Deployed frontend origin, for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Anthropic API key, used only by the "Oppdater lagdata" refresh endpoint - paid, unlike the
# rest of this stack
ANTHROPIC_API_KEY=
