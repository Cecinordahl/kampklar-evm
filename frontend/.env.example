VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base URL of the deployed backend, for admin write requests
VITE_BACKEND_URL=http://localhost:8080

# Local development only: talk to the Firebase emulators instead of the real project
# (then any VITE_FIREBASE_* values work, e.g. VITE_FIREBASE_PROJECT_ID=demo-kampklar)
VITE_USE_FIREBASE_EMULATORS=false
